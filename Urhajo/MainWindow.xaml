<Window x:Class="Urhajo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urhajo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="230"></Setter>
            <Setter Property="Height" Value="25"></Setter>
            <Setter Property="Margin" Value="0 5"></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Width" Value="230"></Setter>
            <Setter Property="Height" Value="20"></Setter>
            <Setter Property="Margin" Value="0 5"></Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Width" Value="230"></Setter>
            <Setter Property="Height" Value="25"></Setter>
            <Setter Property="Margin" Value="0 5"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="DarkBlue">
            <TextBlock Margin="20" FontSize="20" Text="Űrhajó műveletek" Foreground="White" FontWeight="Bold"></TextBlock>
            <Button Content="Adatok betöltése"></Button>
            <Button Content="Hány űrhajó van?"></Button>
            <Button Content="Melyiknek a legnagyobb a hatótáva?"></Button>
            <Button Content="Kik voltak sikeres küldetésen?"></Button>
            <Button Content="Átlagos legénységszám"></Button>
            <Button Content="Gyártók szerinti csoportosítás"></Button>
            <Button Content="Keresés név szerint"></Button>
            <TextBox></TextBox>
        </StackPanel>
        <DataGrid Grid.Column="1" x:Name="datagrid"></DataGrid>
    </Grid>
</Window>
